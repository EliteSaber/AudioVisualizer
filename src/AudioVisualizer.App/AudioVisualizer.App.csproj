<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudioVisualizer.Core\AudioVisualizer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Файл настроек едет рядом с собранным exe: приложение ищет его в своём каталоге
      (AppSettingsStore.Resolve), и без копирования при первом запуске не нашлось бы что читать,
      а писать в папку исходников нельзя.

      PreserveNewest, а не Always: файл в выводе сборки приложение переписывает само, и Always
      стёр бы сохранённое значение при каждой пересборке.

      Update, а не Include: файл уже попал в None глобом SDK, и Include на том же пути дал бы
      NETSDK1022 (повтор элемента).
    -->
    <None Update="settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>