{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/AudioVisualizer.sln"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "run",
      "type": "process",
      "command": "${workspaceFolder}/src/AudioVisualizer.App/bin/Debug/net10.0-windows/AudioVisualizer.App.exe",
      "dependsOn": "build",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/AudioVisualizer.sln", "--no-build"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "clean",
      "type": "process",
      "command": "dotnet",
      "args": ["clean", "${workspaceFolder}/AudioVisualizer.sln"],
      "problemMatcher": ["$msCompile"]
    }
  ]
}