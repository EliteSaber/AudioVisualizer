<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Мета-пакет NAudio тянет Windows-стек целиком: NAudio.Core (AudioFileReader,
      WaveFileWriter), NAudio.Wasapi и Media Foundation для сжатых форматов.
      Отдельные подпакеты не фиксируем, версии они приезжают из мета-пакета.
    -->
    <PackageReference Include="NAudio" Version="3.1.0" />
  </ItemGroup>

<ItemGroup>
    <!--
      UseWPF сужает набор неявных using'ов: System.IO в него не входит. Возвращаем явно,
      файлы аудио работают с файлами и потоками.
    -->
    <Using Include="System.IO" />
  </ItemGroup>

  <!-- Внутренние помощники проверяются тестами, а выносить их в публичный API ради этого не нужно. -->
  <ItemGroup>
    <InternalsVisibleTo Include="AudioVisualizer.Tests" />
  </ItemGroup>

</Project>