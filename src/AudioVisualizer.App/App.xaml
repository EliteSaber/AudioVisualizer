<Application x:Class="AudioVisualizer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AudioVisualizer.App.Controls"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!--
                Иконки кнопок лежат отдельным словарём: их много, они однотипные и к панели
                настроек отношения не имеют.
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <!--
            Тёмная панель настроек: цвета заданы здесь, а не в каждом элементе. Фон кадра
            визуализации берётся из настроек и к панели отношения не имеет.

Все кисти подставляются через StaticResource. Замена их на DynamicResource ради
            будущей светлой темы приводит к переполнению стека на запуске: подстановка внутри
            значения словаря инвалидируется в момент, когда этот словарь ещё не закончил
            создавать своё значение. Значения цветов при выносе не менялись - внешний вид
            должен остаться прежним.
        -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!--
            Шаблон подписи элемента списка. DisplayMemberPath полагается на ленивую генерацию
            шаблона, и в собственном шаблоне ComboBox она до закрытого значения не доезжает:
            список показывал ToString записи. Явный ItemTemplate попадает в SelectionBoxItemTemplate
            напрямую, поэтому подписи видны и в списке, и в закрытом виде.
        -->
        <DataTemplate x:Key="ChoiceTemplate">
            <TextBlock Text="{Binding Title}" />
        </DataTemplate>

        <!-- Подпись пресета выгрузки: имя плюс параметры, чтобы в списке было видно, что внутри.
             Запятая в StringFormat экранирована: разделитель пар свойств разметки тоже запятая. -->
        <DataTemplate x:Key="ExportPresetTemplate">
            <TextBlock>
                <Run Text="{Binding Name}" />
                <Run Text="{Binding Settings, StringFormat={} — {0.Width}x{0.Height}\, {0.FramesPerSecond} к/с}" />
            </TextBlock>
        </DataTemplate>

        <SolidColorBrush x:Key="PanelBackground" Color="#FF2B2B31" />
        <SolidColorBrush x:Key="PanelBorder" Color="#FF45454D" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFE2E2E6" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FF9A9AA4" />
        <SolidColorBrush x:Key="StatusErrorBrush" Color="#FFE05C5C" />
        <SolidColorBrush x:Key="ControlBackground" Color="#FF3A3A42" />
        <SolidColorBrush x:Key="SelectionBackground" Color="#FF2F6FD0" />
        <SolidColorBrush x:Key="SelectionText" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="WindowBackground" Color="#FF232329" />
        <SolidColorBrush x:Key="PreviewBackground" Color="#FF15151A" />
        <SolidColorBrush x:Key="HoverBorderBrush" Color="#FF7A7A88" />
        <SolidColorBrush x:Key="ItemHighlightBrush" Color="#FF4C4C57" />
        <SolidColorBrush x:Key="TabHoverBrush" Color="#FF44444E" />
        <SolidColorBrush x:Key="TabSelectedBrush" Color="#FF585865" />
        <SolidColorBrush x:Key="PopupBackground" Color="#FF2E2E35" />
        <SolidColorBrush x:Key="PopupBorderBrush" Color="#FF55555C" />
        <SolidColorBrush x:Key="PopupTextBrush" Color="#FFD0D0D0" />

        <!--
            Цвет тени попапа - тоже ресурс, а не литерал в разметке. Тень принимает Color,
            а не кисть, так что объявить её можно только так; правило "цвета только через
            словарь" из-за этого не приходится оговаривать отдельно.
        -->
        <Color x:Key="PopupShadowColor">#FF000000</Color>
<SolidColorBrush x:Key="SwatchBorderBrush" Color="#FF6A6A70" />

        <!--
            Состояния иконки отдельно от цвета текста: при наведении иконка светлеет, при
            отключении гаснет. Отдельными кистями, а не прозрачностью всей кнопки, потому
            что прозрачность гасила бы и подложку, и всплывающую подсказку.
        -->
        <SolidColorBrush x:Key="IconBrush" Color="#FFE2E2E6" />
        <SolidColorBrush x:Key="IconHoverBrush" Color="#FFFFFFFF" />

        <!--
            Полоса прокрутки: три состояния бегунка заданы отдельными кистями, а не прозрачностью
            одного цвета. Белый штрих, положенный на светлую подложку, выцветает, поэтому для
            светлой темы такие состояния пришлось бы всё равно объявлять заново.

            Дорожка - тоже кисть, а не Transparent: в тёмной панели она не нужна, а в светлой
            без неё бегунок повисает в воздухе.

            Названы по назначению, а не по цвету: смена темы меняет значения в этих же ключах,
            и ни одна строка разметки под неё не трогается.
        -->
        <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#002B2B31" />
        <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#FF4E4E59" />
        <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#FF6E6E7C" />
        <SolidColorBrush x:Key="ScrollBarThumbPressedBrush" Color="#FF7A7A88" />

        <!--
            Кнопка-иконка без подписи: подпись переехала в ToolTip и в AutomationProperties.Name,
            поэтому без него кнопка не называется ни мышью, ни программой чтения с экрана.

            Своя подложка обязательна: тема Aero2 красит фон прямо на внутреннем Border
            шаблона, и иконка оказалась бы на серой системной кнопке. SnapsToDevicePixels не
            даёт штрихам ползти на дробном масштабе.

            Стиль и шаблон живут здесь, а не в Theme\Icons.xaml вместе с контурами: тот
            словарь подключается через Source и грузится лениво. В этом файле остаются
            только геометрии - они ни на что не ссылаются.
        -->
        <ControlTemplate x:Key="IconButtonTemplate" TargetType="{x:Type Button}">
            <Border x:Name="Surface"
                    Padding="{TemplateBinding Padding}"
                    Background="Transparent"
                    CornerRadius="3"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Surface" Property="Background" Value="{StaticResource ControlBackground}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Surface" Property="Opacity" Value="0.6" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="IconButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template" Value="{StaticResource IconButtonTemplate}" />
        </Style>

        <!--
            Рисунок иконки. Состояние одно - наведение, и его приходится спрашивать у
            кнопки-предка: IsMouseOver не наследуется, и у Path своего состояния нет.

            Отдельного цвета для отключённой иконки нет намеренно: гасит вся кнопка в
            шаблоне (Opacity), и второй триггер с собственной раскраской только дублировал бы
            то же самое. Обращение к IsEnabled рисунка с RelativeSource AncestorType работало бы,
            но держится на визуальном дереве и слетает, пока кнопка не измерена.
        -->
        <Style x:Key="IconPath" TargetType="{x:Type Path}">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{StaticResource IconBrush}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Stroke" Value="{StaticResource IconHoverBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            Залитый вариант рисунка: стрелка кругового обновления задана заливкой, и обводка
            дала бы тонкий контур вместо стрелки. Состояние наведения наследуется от
            IconPath, поэтому правится в одном месте и для обоих вариантов.
        -->
        <Style x:Key="IconPathSolid" TargetType="{x:Type Path}" BasedOn="{StaticResource IconPath}">
            <Setter Property="Fill" Value="{StaticResource IconBrush}" />
            <Setter Property="Stroke" Value="{x:Null}" />
            <Setter Property="StrokeThickness" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource IconHoverBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            Кнопка с текстом для диалогов. Отдельный шаблон нужен не из-за рисунка: у иконочной
            кнопки жёстко заданы 32x30 и нулевой отступ, и текст в ней обрежется. Системная тема
            красит кнопку сама, поэтому свой шаблон обязателен в любом случае - иначе диалог
            окажется серой кнопкой Aero2 посреди тёмной панели.
        -->
        <ControlTemplate x:Key="DialogButtonTemplate" TargetType="{x:Type Button}">
            <Border x:Name="Surface"
                    Padding="{TemplateBinding Padding}"
                    Background="{StaticResource ControlBackground}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="3"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Surface" Property="Opacity" Value="0.7" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DialogButton" TargetType="{x:Type Button}">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template" Value="{StaticResource DialogButtonTemplate}" />
        </Style>

        <Style TargetType="{x:Type controls:SettingRow}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:SettingRow}">
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Margin="0,0,10,0"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="{TemplateBinding Label}" />
                            <ContentPresenter Grid.Column="1" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TextBlock}" x:Key="SectionHeader">
            <Setter Property="Margin" Value="0,4,0,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>

        <Style TargetType="{x:Type Slider}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{StaticResource ControlBackground}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="Padding" Value="4,3" />
        </Style>

        <!--
            Собственные шаблоны вместо сеттеров. Тема Aero2 красит фон прямо на внутреннем
            Border шаблона, и её триггер сильнее сеттера на самом элементе: состояния
            наведения и выбора рисовались системными цветами. Здесь фон рисует наш Border,
            поэтому все три состояния под нашим контролем.

            Порядок триггеров: сначала наведение, затем выбранное - при совпадении обоих
            выигрывает последний.
        -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>

                            <!--
                                Видимая часть: значение и стрелка. ContentPresenter держим
                                в шаблоне ComboBox, а не в шаблоне ToggleButton: TemplateBinding
                                смотрит только в ближайший templated parent, и внутри вложенного
                                шаблона он искал бы свойство у кнопки, а не у списка.
                            -->
                            <Border x:Name="ToggleRoot"
                                    Padding="6,3"
                                    Background="{StaticResource ControlBackground}"
                                    BorderBrush="{StaticResource PanelBorder}"
                                    BorderThickness="1"
                                    TextElement.Foreground="{TemplateBinding Foreground}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Margin="2,0,4,0"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                    <TextBlock Grid.Column="1"
                                               Margin="0,0,2,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextBrush}"
                                               Text="▾" />
                                </Grid>
                            </Border>

                            <!-- Прозрачный слой поверх рамки: он ловит клик и открывает список. -->
                            <ToggleButton x:Name="Toggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <!--
                                    Свой пустой шаблон обязателен: без него применяется тема, и она
                                    красит поверх прозрачного слоя свою рамку с голубой подсветкой
                                    наведения - ровно то, что нужно убрать.
                                -->
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- PART_Popup: базовый класс ComboBox ищет попап по этому имени. -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   Placement="Bottom"
                                   PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <!--
                                    Палитра попапа - всплывающая, а не палитра поля. На палитре
                                    поля раскрытый список совпадает с закрытым и по заливке, и по
                                    рамке, и получается один прямоугольник. Эти кисти объявлены для
                                    попапа палитры цвета, и списку они подходят по назначению те же.

                                    Но палитрой список от панели не отделяется: PopupBackground и
                                    PanelBackground различаются на три единицы из 255, и глазом это
                                    один цвет. Отделяет тень. Поля на внешней рамке обязательны:
                                    эффект не входит в размер элемента, и окно попапа обрежет тень
                                    по своим границам. Зазор над списком получается 4 px, а сам
                                    попап становится шире закрытого поля на 8 px.
                                -->
                                <Border Margin="2,4,6,8" Background="Transparent">
                                    <Border MinWidth="{TemplateBinding ActualWidth}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                            Background="{StaticResource PopupBackground}"
                                            BorderBrush="{StaticResource PopupBorderBrush}"
                                            BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="3" Direction="270" Opacity="0.6"
                                                              Color="{StaticResource PopupShadowColor}" />
                                        </Border.Effect>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Border>
                            </Popup>

                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleRoot" Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ToggleRoot" Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

<!--
                            Заливку пункта задаёт рамка попапа, а не сам пункт. Пункт красил
                            себя кистью поля, и попап под ним не было видно вовсе: смена
                            PopupBackground меняла только попап палитры цвета, а список оставался
                            прежним - и список был покрашен в цвет закрытого поля, поэтому
                            открытый и закрытый списки выглядели одинаково. Состояния ниже
                            прозрачность переопределяют, как и раньше переопределяли заливку.
                        -->
                        <Style TargetType="{x:Type ComboBoxItem}">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="Padding" Value="6,4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                        <Border x:Name="ItemRoot"
                                                Padding="{TemplateBinding Padding}"
                                                Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource ItemHighlightBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource SelectionBackground}" />
                                                <Setter Property="Foreground" Value="{StaticResource SelectionText}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabRoot"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3,3,0,0"
                                Background="{StaticResource ControlBackground}"
                                BorderBrush="{StaticResource PanelBorder}"
                                BorderThickness="1"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="{StaticResource TabHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="{StaticResource TabSelectedBrush}" />
                                <Setter TargetName="TabRoot" Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Своя полоса прокрутки вместо системной. Тема Aero2 рисует светло-серое полотно с
            бегунком и кнопками-стрелками, и в тёмной панели это выглядит чужой вставкой:
            полосы стоят на четырёх вкладках, в раскрытом списке и в поле сообщения.

            Объявлено неявным стилем, а не по ключу: полосы заводит не разметка, а шаблоны
            ScrollViewer и TextBox, и на неявный стиль приложения они смотрят сами. Ссылка по
            ключу потребовала бы проставить её в каждом ScrollViewer, а забытую ссылку
            ничто не поймает: полоса без своего стиля просто рисуется системная.

            Подстановка по смене ресурса в словаре приложения не проверена запуском, поэтому
            все ссылки обычные, как и в остальной палитре.
        -->

        <!--
            Кнопки страниц - прозрачные и без рисунка. Нужны не ради рисунка, а ради клика:
            Track обрабатывает мышь только за бегунком, а листает страницей нажатие на кнопке
            под ним. Без кнопок клик по дорожке не листает ничего, и колесо остаётся
            единственным способом прокрутки.

            Шаблон у кнопки свой и пустой обязателен: тема красит кнопки сама, и без него на
            торцах дорожки выросли бы системные стрелки.
        -->
        <ControlTemplate x:Key="ScrollBarPageButtonTemplate" TargetType="{x:Type RepeatButton}">
            <Border Background="Transparent" />
        </ControlTemplate>

        <Style x:Key="ScrollBarPageButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template" Value="{StaticResource ScrollBarPageButtonTemplate}" />
        </Style>

        <!--
            Бегунок: заливка цветом и радиус, длину отдаёт дорожка. Собственный шаблон у Thumb
            обязателен - иначе система нарисует бегунок сама, и стилизация полосы сведётся
            на нет, хотя по коду всё выглядит сделанным.

            Состояние наведения берётся у полосы-владельца: IsMouseOver не наследуется, и у
            самого бегунка своего состояния нет - он узкий, и наводить пришлось бы на всю
            полосу, чтобы он посветлел.
        -->
        <ControlTemplate x:Key="ScrollBarThumbTemplate" TargetType="{x:Type Thumb}">
            <Border x:Name="ThumbSurface"
                    Background="{StaticResource ScrollBarThumbBrush}"
                    CornerRadius="3"
                    SnapsToDevicePixels="True" />
            <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}"
                             Value="True">
                    <Setter TargetName="ThumbSurface" Property="Background" Value="{StaticResource ScrollBarThumbHoverBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDragging, RelativeSource={RelativeSource Self}}"
                             Value="True">
                    <Setter TargetName="ThumbSurface" Property="Background" Value="{StaticResource ScrollBarThumbPressedBrush}" />
                </DataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
            <!--
                Поля у бегунка не заданы: они одинаковы вдоль полосы и разные поперёк неё, то
                есть свои у каждой ориентации. Заданы триггерами шаблона полосы.
            -->
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template" Value="{StaticResource ScrollBarThumbTemplate}" />
        </Style>

        <ControlTemplate x:Key="ScrollBarTemplate" TargetType="{x:Type ScrollBar}">
            <!--
                Дорожка лежит в сетке: сам Track ничего не рисует, а красить дорожку нужно —
                в тёмной теме она прозрачная, в светлой без неё бегунок повисает в воздухе.

                Имя PART_Track обязательно: ScrollBar.OnApplyTemplate ищет дорожку только по
                нему и без него тихо остаётся без полосы.

                В Track кладётся именно Thumb, а не вложенная дорожка: тип у Track.Thumb один,
                и вложенный Track в это место не годится.
            -->
            <Grid Background="{StaticResource ScrollBarTrackBrush}">
                <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageUpCommand"
                                      Delay="400"
                                      Interval="80"
                                      Style="{StaticResource ScrollBarPageButton}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb x:Name="PART_Thumb" Style="{StaticResource ScrollBarThumb}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageDownCommand"
                                      Delay="400"
                                      Interval="80"
                                      Style="{StaticResource ScrollBarPageButton}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>

            <!--
                Ориентация задана в обоих триггерах, а не по умолчанию: у Track она по
                умолчанию горизонтальная, и вертикальная полоса без её явной установки
                получила бы дорожку поперёк себя.

                Разворот направления - обязательная часть, а не украшение: без него дорожка
                идёт не в ту сторону и значение полосы читалось бы наоборот.

                Поля бегунка - тоже по ориентации: отступ нужен поперёк полосы, чтобы
                отодвинуть бегунок от краёв дорожки, и не нужен вдоль неё. Общими полями он
                потерял бы шесть пикселей своей длины на горизонтальной полосе.
            -->
            <ControlTemplate.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter TargetName="PART_Track" Property="Orientation" Value="Vertical" />
                    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="True" />
                    <Setter TargetName="PART_Thumb" Property="Margin" Value="3,0" />
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal" />
                    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                    <Setter TargetName="PART_Thumb" Property="Margin" Value="0,3" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="{x:Type ScrollBar}">
            <!--
                12 px против системных 17: панель настроек шириной 330 px, и лишние пять
                пикселей уходили под подписи настроек. Тонкая полоса здесь самое то, а в
                поле сообщения, где текст моноширинный, ширина не значит ничего.
            -->
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="Template" Value="{StaticResource ScrollBarTemplate}" />

            <Style.Triggers>
                <!--
                    У горизонтальной полосы наоборот: ширина неограниченная, иначе она не
                    растянулась бы вдоль прокручиваемой области, а толщина та же. Горизонтальных
                    полос в приложении нет, но шаблон один на обе ориентации.
                -->
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="12" />
                    <Setter Property="MinHeight" Value="12" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </ResourceDictionary>
    </Application.Resources>
</Application>
