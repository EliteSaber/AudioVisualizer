<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!--
      Иконка встраивается в exe как ресурс Win32, и её получают проводник, панель задач,
      Alt-Tab и заголовок окна. Свойство Icon у окна задавать не нужно: WPF и так берёт
      иконку сборки, а объявлять .ico ресурсом WPF пришлось бы только ради ссылки на него
      из разметки, которой здесь нет.
    -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudioVisualizer.Core\AudioVisualizer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Файл настроек едет рядом с собранным exe: приложение ищет его в своём каталоге
      (AppSettingsStore.Resolve), и без копирования при первом запуске не нашлось бы что читать,
      а писать в папку исходников нельзя.

      PreserveNewest, а не Always: файл в выводе сборки приложение переписывает само, и Always
      стёр бы сохранённое значение при каждой пересборке.

      Update, а не Include: файл уже попал в None глобом SDK, и Include на том же пути дал бы
      NETSDK1022 (повтор элемента).
    -->
    <None Update="settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Именованные элементы разметки компилируются во внутренние поля, и без этой строки тесты
    окна не видели бы их содержимого. Публичным API ради проверки сделано не всё приложение,
    а ровно то, что и так internal.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="AudioVisualizer.Tests" />
  </ItemGroup>

</Project>