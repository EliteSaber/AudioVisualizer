<UserControl x:Class="AudioVisualizer.App.Controls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="220"
             PreviewKeyDown="OnPreviewKeyDown">
    <StackPanel>

        <StackPanel Orientation="Horizontal">
            <Border x:Name="Swatch"
                    Width="52"
                    Height="24"
                    BorderBrush="{StaticResource SwatchBorderBrush}"
                    BorderThickness="1"
                    Cursor="Hand"
                    MouseLeftButtonUp="OnSwatchClick"
                    ToolTip="Выбрать цвет" />
            <TextBlock x:Name="HexLabel"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource PopupTextBrush}"
                       FontFamily="Consolas" />
        </StackPanel>

        <Popup x:Name="ColorPopup"
               AllowsTransparency="True"
               Placement="Bottom"
               StaysOpen="False">
            <Border Margin="0,4,0,0"
                    Padding="12"
                    Width="260"
                    Background="{StaticResource PopupBackground}"
                    BorderBrush="{StaticResource PopupBorderBrush}"
                    BorderThickness="1"
                    PreviewKeyDown="OnPreviewKeyDown">
                <StackPanel>

                    <TextBlock Text="Красный" Foreground="{StaticResource PopupTextBrush}" Margin="0,0,0,2" />
                    <Slider x:Name="RedSlider" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" ValueChanged="OnChannelChanged" />

                    <TextBlock Text="Зелёный" Foreground="{StaticResource PopupTextBrush}" Margin="0,8,0,2" />
                    <Slider x:Name="GreenSlider" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" ValueChanged="OnChannelChanged" />

                    <TextBlock Text="Синий" Foreground="{StaticResource PopupTextBrush}" Margin="0,8,0,2" />
                    <Slider x:Name="BlueSlider" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" ValueChanged="OnChannelChanged" />

                    <TextBlock Text="Прозрачность (A)" Foreground="{StaticResource PopupTextBrush}" Margin="0,8,0,2" />
                    <Slider x:Name="AlphaSlider" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" ValueChanged="OnChannelChanged" />

                    <CheckBox x:Name="TransparentCheckBox"
                              Margin="0,10,0,0"
                              Content="Прозрачный цвет (A = 0)"
                              Foreground="{StaticResource PopupTextBrush}"
                              Checked="OnTransparentChecked"
                              Unchecked="OnTransparentChecked" />

                    <TextBlock Text="Цвет в формате #RRGGBBAA" Foreground="{StaticResource PopupTextBrush}" Margin="0,10,0,2" />
                    <TextBox x:Name="HexInput"
                             FontFamily="Consolas"
                             KeyDown="OnHexKeyDown"
                             LostFocus="OnHexLostFocus" />

                </StackPanel>
            </Border>
        </Popup>

    </StackPanel>
</UserControl>