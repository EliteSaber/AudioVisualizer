<!--
    Иконки кнопок и шаблон кнопки-иконки.

    Контуры заданы в сетке 24x24 и рисуются штрихом: у всех иконок одна толщина и одни
    скруглённые стыки, поэтому рядом они выглядят родственниками. Заливки нет намеренно -
    заливка нужна только для стрелок, а смешивать два стиля в одном наборе хуже, чем
    обвести контур.

    Цвет берётся из Foreground кнопки, а он по умолчанию ссылается на кисть текста: смена
    темы меняет и иконки, и перекрашивать контуры руками не нужно.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<!--
        Все рисунки приведены к общему полю: длинная сторона 16 единиц, короткая не меньше
        10. Path рисует их в квадрате 16x16 с растяжением по большей стороне, поэтому разные
        габариты означали разный видимый размер: пауза была втрое уже корзины, а «сохранить
        как» вписывалась по ширине и садилась ниже соседей.

        Координаты заданы в сетке 24x24; проверка размеров живёт в IconButtonTests.
    -->

    <!-- Открыть файл: папка. -->
    <Geometry x:Key="IconOpen">M4,6 H10 L12,8 H20 V19 H4 Z</Geometry>

    <!-- Сохранить: дискета с прорезью сверху и подписью снизу. -->
    <GeometryGroup x:Key="IconSave">
        <PathGeometry Figures="M4,5 H17 L20,8 V19 H4 Z" />
        <PathGeometry Figures="M8,5 V10 H16 V5" />
        <PathGeometry Figures="M8,19 V14 H16 V19" />
    </GeometryGroup>

    <!-- Сохранить пресет: лист со загнутым углом и стрелкой наружу - приём «сохранить как». -->
    <GeometryGroup x:Key="IconSaveAs">
        <PathGeometry Figures="M7,4 H15 L19,8 V20 H7 Z" />
        <PathGeometry Figures="M15,4 V8 H19" />
        <PathGeometry Figures="M10,12 H15 M15,12 L12,9 M15,12 L12,15" />
    </GeometryGroup>

    <!-- Удалить: корзина. -->
    <GeometryGroup x:Key="IconDelete">
        <PathGeometry Figures="M4,6 H20" />
        <PathGeometry Figures="M9,6 V4 H15 V6" />
        <PathGeometry Figures="M6,7 L7,20 H17 L18,7" />
        <PathGeometry Figures="M10,10 V17 M14,10 V17" />
    </GeometryGroup>

    <!-- Сброс: залитая стрелка кругового обновления. Рисунок задан в своей сетке 54x54 и
         обводить его нельзя: обводка дала бы тонкий контур вместо стрелки, поэтому знак
         рисуется заливкой (стиль IconPathSolid). -->
    <Geometry x:Key="IconReset">M 27.9999 54.4024 C 41.0546 54.4024 51.9063 43.5742 51.9063 30.4961 C 51.9063 18.9649 43.4687 9.1914 32.5234 7.0351 L 32.5234 3.7070 C 32.5234 2.0430 31.3749 1.5976 30.0858 2.5117 L 22.6093 7.7383 C 21.5546 8.4883 21.5312 9.6133 22.6093 10.3867 L 30.0624 15.6367 C 31.3749 16.5742 32.5234 16.1289 32.5234 14.4414 L 32.5234 11.0898 C 41.3827 13.1055 47.8983 21.0039 47.8983 30.4961 C 47.8983 41.5586 39.0390 50.4180 27.9999 50.4180 C 16.9374 50.4180 8.0546 41.5586 8.0780 30.4961 C 8.1014 23.8398 11.3358 17.9570 16.3280 14.3945 C 17.2890 13.6680 17.5936 12.5664 16.9843 11.5820 C 16.4218 10.6211 15.1327 10.3633 14.1014 11.1602 C 8.0546 15.5430 4.0937 22.6211 4.0937 30.4961 C 4.0937 43.5742 14.9218 54.4024 27.9999 54.4024 Z</Geometry>

    <Geometry x:Key="IconPlay">M7,4 L19,12 L7,20 Z</Geometry>

    <Geometry x:Key="IconPause">M6,4 V20 M18,4 V20</Geometry>

    <Geometry x:Key="IconStop">M5,5 H19 V19 H5 Z</Geometry>

    <!-- Громкость: динамик и две дуги волны. Двойной крест вместо дуг означает выключение. -->
    <GeometryGroup x:Key="IconVolume">
        <PathGeometry Figures="M5,9 H9 L14,4 V20 L9,15 H5 Z" />
        <PathGeometry Figures="M16,9 Q19,12 16,15" />
        <PathGeometry Figures="M18,6.5 Q22,12 18,17.5" />
    </GeometryGroup>

    <!-- Выключенный звук: динамик с крестом. -->
    <GeometryGroup x:Key="IconMute">
        <PathGeometry Figures="M5,9 H9 L14,4 V20 L9,15 H5 Z" />
        <PathGeometry Figures="M16,9 L21,14 M21,9 L16,14" />
    </GeometryGroup>

    <!-- Выгрузить: стрелка вниз на подставку. -->
    <Geometry x:Key="IconExport">M12,3 V14 M8,10 L12,14 L16,10 M4,19 H20</Geometry>

    <!-- Отмена: крест. -->
    <Geometry x:Key="IconCancel">M4,4 L20,20 M20,4 L4,20</Geometry>
    <!--
        Стиль кнопки и стиль рисунка иконки живут в App.xaml рядом с кистями, и это не вопрос
        вкуса.

        Словарь подключается через Source и грузится лениво. Значение, которое тянет ресурс
        из словаря приложения, при обращении к ключу создаёт само себя, становится контекстом
        наследования и снова инвалидирует подстановку - приложение падает переполнением
        стека на запуске.

        Поэтому здесь только геометрии: они ни на что не ссылаются и потому безопасны при
        ленивой загрузке. Стили с ресурсами - только в основном словаре приложения.
    -->

</ResourceDictionary>