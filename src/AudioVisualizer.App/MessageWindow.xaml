<Window x:Class="AudioVisualizer.App.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AudioVisualizer"
        Width="560"
        SizeToContent="Height"
        MinWidth="420"
        MaxHeight="620"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">

    <!--
        Сообщение показывается окном, а не строкой статуса: подробности про ffmpeg и
        команда запуска занимают пол-экрана, а строка статуса обрезает их многоточием.

        Высота ограничена сверху: без этого окно выросло бы на весь текст и перестало
        помещаться на экране. Прокрутка живёт в самом поле, отдельный ScrollViewer не нужен.
    -->
    <Grid Margin="18,16,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingBlock"
                   Style="{DynamicResource SectionHeader}"
                   TextWrapping="Wrap" />

        <TextBox x:Name="MessageBox"
                 Grid.Row="1"
                 MinHeight="90"
                 MaxHeight="360"
                 Padding="10"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 Background="{DynamicResource PreviewBackground}"
                 Foreground="{DynamicResource TextBrush}"
                 BorderBrush="{DynamicResource PanelBorder}"
                 BorderThickness="1"
                 FontFamily="Consolas, Courier New" />

        <StackPanel Grid.Row="2"
                    Margin="0,14,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="FolderButton"
                    Margin="0,0,8,0"
                    Content="Открыть папку"
                    Style="{DynamicResource DialogButton}"
                    Visibility="Collapsed"
                    Click="OnFolderClick" />
            <Button Content="Закрыть"
                    IsDefault="True"
                    IsCancel="True"
                    Style="{DynamicResource DialogButton}"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>