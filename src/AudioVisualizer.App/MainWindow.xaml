<Window x:Class="AudioVisualizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AudioVisualizer.App.Controls"
        xmlns:core="clr-namespace:AudioVisualizer.Core.Rendering;assembly=AudioVisualizer.Core"
        mc:Ignorable="d"
        Title="AudioVisualizer"
        Width="1480"
        Height="920"
        MinWidth="1100"
        MinHeight="680"
        Background="{StaticResource WindowBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <Grid Margin="12,10,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                Кнопки без подписи: название живёт в ToolTip и в AutomationProperties.Name.
                Второе нужно, чтобы кнопка была названа программе чтения с экрана - по одному
                ToolTip этого не добиться. Рисунок вынесен в Path: состояния иконки
                (светлеет при наведении, гаснет при отключении) берутся у кнопки-предка.
            -->
            <Button Style="{StaticResource IconButton}"
                    Command="{Binding OpenFileCommand}"
                    ToolTip="Открыть файл"
                    AutomationProperties.Name="Открыть файл">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconOpen}" />
            </Button>

            <!--
                Имя файла и длительность живут в колонке на всю оставшуюся ширину: в DockPanel
                элементы слева измеряются без ограничения, длинное имя выдавило бы кнопки вправо,
                а TextTrimming при таком измерении не срабатывает.
            -->
            <StackPanel Grid.Column="1"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <TextBlock MaxWidth="360"
                           TextTrimming="CharacterEllipsis"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           ToolTip="{Binding FileTitle}"
                           Text="{Binding FileTitle}" />
            </StackPanel>

            <!--
                Кнопки «сохранить» нет: настройки и так пишутся при выходе из окна, и
                состояния «несохранённые правки» не существует. Перезаписывать файл вручную
                незачем, а нажатие без видимого результата только путает.
            -->
            <StackPanel Grid.Column="2" Margin="24,0,0,0" Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}"
                        Command="{Binding ResetSettingsCommand}"
                        ToolTip="Сбросить все настройки"
                        AutomationProperties.Name="Сбросить все настройки">
                    <Path Style="{StaticResource IconPathSolid}" Data="{StaticResource IconReset}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Панель воспроизведения -->
        <Grid Grid.Row="1" Margin="12,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Width="44"
                    Height="34"
                    IsEnabled="{Binding HasTrack}"
                    Command="{Binding TogglePlayCommand}">
                <!-- Иконка и подсказка задаются в стиле: локальные значения перебили бы триггер. -->
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource IconButton}">
                        <Setter Property="Content">
                            <Setter.Value>
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPlay}" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="ToolTip" Value="Воспроизвести" />
                        <Setter Property="AutomationProperties.Name" Value="Воспроизвести" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPause}" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="ToolTip" Value="Пауза" />
                                <Setter Property="AutomationProperties.Name" Value="Пауза" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Grid.Column="1"
                    Width="44"
                    Height="34"
                    Margin="6,0,0,0"
                    IsEnabled="{Binding HasTrack}"
                    Command="{Binding StopPlaybackCommand}"
                    ToolTip="Остановить и вернуть в начало"
                    AutomationProperties.Name="Остановить"
                    Style="{StaticResource IconButton}">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconStop}" />
            </Button>

<!--
                Значение ползунка намеренно не привязано к модели представления.

                Привязка Value у элемента, которым манипулирует пользователь, всегда
                конфликтует: ползунок меняет значение локально, а источник подталкивает своё.
                При воспроизведении источник обновляется каждые 16 мс, и между нажатием и
                отпусканием значение успевает затереться старой позицией - перемотка
                не доходит до модели. Поэтому окно выставляет значение само, подписываясь
                на PositionChanged, и молчит, пока пользователь тянет бегунок.

                Начало перемотки ловится в коде-бэкенде по изменению значения, а не
                событием нажатия: нажатие до ползунка не доходит, а значение меняется
                всегда, когда им пользуется человек. Отпускание - туннельное событие,
                обычные MouseLeftButtonUp классовые обработчики Slider и Thumb
                помечают обработанными раньше наших.

                IsMoveToPointEnabled переносит бегунок по клику на дорожке.
            -->
            <Slider x:Name="PositionSlider"
                    Grid.Column="2"
                    Margin="14,0,14,0"
                    IsEnabled="{Binding HasTrack}"
                    IsMoveToPointEnabled="True"
                    Maximum="{Binding Duration.TotalSeconds}"
                    PreviewMouseLeftButtonUp="OnScrubMouseUp" />

            <TextBlock Grid.Column="3"
                       MinWidth="96"
                       VerticalAlignment="Center"
                       TextAlignment="Right"
                       FontFamily="Consolas"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="{Binding TimeLabel}" />

            <!--
                TwoWay-привязка безопасна: ползунок двигает только человек, громкость при
                запуске попадает в модель полем, минуя свойство, и затереть значение жеста
                программа не может. Ноль и есть выключенный звук, отдельного состояния нет:
                кнопка помнит громкость до отключения и возвращает её назад.

                TickFrequency обязателен: глобальный стиль включает привязку к тикам всем
                ползункам, а умолчание WPF у TickFrequency - 1.0. Без явной частоты ползунок
                0…1 щёлкает только краями: ноль или сто процентов. Позиция спасается тем,
                что её тик - целая секунда, и уши это не замечают.

                Шаги клавиатуры заданы свои: у RangeBase LargeChange по умолчанию 1, а у
                ползунка 0…1 это прыжок с нуля на сто процентов по PageUp. SmallChange в
                умолчании 0.1 - это десять процентов за нажатие стрелки, слишком много.

                Имя для чтения с экрана постоянное: значение ползунка и так объявляется
                само, а имя, меняющееся вместе с процентом, только шумит.
            -->
            <Button Grid.Column="4"
                    Width="44"
                    Height="34"
                    Margin="12,0,0,0"
                    IsEnabled="{Binding HasTrack}"
                    Command="{Binding ToggleMuteCommand}">
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource IconButton}">
                        <Setter Property="Content">
                            <Setter.Value>
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconVolume}" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="ToolTip" Value="Выключить звук" />
                        <Setter Property="AutomationProperties.Name" Value="Выключить звук" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconMute}" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="ToolTip" Value="Включить звук" />
                                <Setter Property="AutomationProperties.Name" Value="Включить звук" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Slider x:Name="VolumeSlider"
                    Grid.Column="5"
                    Width="90"
                    Minimum="0"
                    Maximum="1"
                    Value="{Binding Volume}"
                    TickFrequency="0.01"
                    SmallChange="0.01"
                    LargeChange="0.1"
                    IsEnabled="{Binding HasTrack}"
                    IsMoveToPointEnabled="True"
                    VerticalAlignment="Center"
                    ToolTip="{Binding VolumeLabel}"
                    AutomationProperties.Name="Громкость" />
        </Grid>

        <!-- Превью и настройки -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Margin="0,0,12,12"
                    Background="{StaticResource PreviewBackground}"
                    BorderBrush="{StaticResource PreviewBackground}"
                    BorderThickness="1">
                <Viewbox Stretch="Uniform">
                    <Border Width="{Binding PreviewWidth}"
                            Height="{Binding PreviewHeight}">
                        <core:SpectrumElement Snapshot="{Binding Snapshot}" />
                    </Border>
                </Viewbox>
            </Border>

            <Border Grid.Column="1"
                    Width="330"
                    Margin="0,0,12,12"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1">
                <TabControl x:Name="SettingsTabs"
                            Margin="8"
                            Background="{StaticResource PanelBackground}"
                            BorderThickness="0"
                            SelectionChanged="OnSettingsTabChanged">

                    <!-- Цвета -->
                    <TabItem Header="Цвета">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,0,0">
                            <StackPanel>
                                <controls:SettingRow Label="Цвет фона">
                                    <controls:ColorPicker Color="{Binding Settings.BackgroundColor, Mode=TwoWay}" />
                                </controls:SettingRow>
                                <controls:SettingRow Label="Столбик у центра">
                                    <controls:ColorPicker Color="{Binding Settings.BarFillColor, Mode=TwoWay}" />
                                </controls:SettingRow>
                                <controls:SettingRow Label="Столбик у края">
                                    <controls:ColorPicker Color="{Binding Settings.BarSecondaryColor, Mode=TwoWay}" />
                                </controls:SettingRow>
                                <controls:SettingRow Label="Граница столбика">
                                    <controls:ColorPicker Color="{Binding Settings.BarBorderColor, Mode=TwoWay}" />
                                </controls:SettingRow>
                                <controls:SettingRow Label="Центральная линия">
                                    <controls:ColorPicker Color="{Binding Settings.CenterLineColor, Mode=TwoWay}" />
                                </controls:SettingRow>

                                <!-- Сброс вкладки возвращает только её настройки: общая кнопка
                                     сверху трогает всё сразу и настроить половину экрана так нельзя. -->
                                <Button HorizontalAlignment="Right"
                                        Margin="0,10,0,0"
                                        Style="{StaticResource IconButton}"
                                        ToolTip="Сбросить цвета"
                                        Command="{Binding Settings.ResetColorsCommand}"
                                        AutomationProperties.Name="Сбросить цвета">
                                    <Path Style="{StaticResource IconPathSolid}" Data="{StaticResource IconReset}" />
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Столбики -->
                    <TabItem Header="Столбики">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,0,0">
                            <StackPanel>
                                <controls:SettingRow Label="{Binding Settings.BarWidth, StringFormat={}Ширина: {0} px}">
                                    <Slider Minimum="1" Maximum="80" Value="{Binding Settings.BarWidth, Mode=TwoWay}" />
                                </controls:SettingRow>
                                <controls:SettingRow Label="{Binding Settings.BarSpacing, StringFormat={}Промежуток: {0} px}">
                                    <Slider Minimum="0" Maximum="40" Value="{Binding Settings.BarSpacing, Mode=TwoWay}" />
                                </controls:SettingRow>
                                <controls:SettingRow Label="{Binding Settings.BarCornerRadius, StringFormat={}Скругление: {0} px}">
                                    <Slider Minimum="0" Maximum="40" Value="{Binding Settings.BarCornerRadius, Mode=TwoWay}" />
                                </controls:SettingRow>
                                <controls:SettingRow Label="Форма углов">
                                    <ComboBox ItemsSource="{Binding Settings.CornerStyleChoices}"
                                              ItemTemplate="{StaticResource ChoiceTemplate}"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding Settings.BarCornerStyle, Mode=TwoWay}" />
                                </controls:SettingRow>
                                <controls:SettingRow Label="{Binding Settings.BarBorderThickness, StringFormat={}Граница: {0:0.#} px}">
                                    <Slider Minimum="0" Maximum="10" Value="{Binding Settings.BarBorderThickness, Mode=TwoWay}" />
                                </controls:SettingRow>
                                <controls:SettingRow Label="Заливка">
                                    <ComboBox ItemsSource="{Binding Settings.FillModeChoices}"
                                              ItemTemplate="{StaticResource ChoiceTemplate}"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding Settings.BarFillMode, Mode=TwoWay}" />
                                </controls:SettingRow>
                                <controls:SettingRow Label="{Binding Settings.BarMargin, StringFormat={}Отступ от края: {0} px}">
                                    <Slider Minimum="0" Maximum="400" Value="{Binding Settings.BarMargin, Mode=TwoWay}" />
                                </controls:SettingRow>
                                <controls:SettingRow Label="{Binding Settings.BarCenterGap, StringFormat={}Зазор у центра: {0} px}">
                                    <Slider Minimum="0" Maximum="120" Value="{Binding Settings.BarCenterGap, Mode=TwoWay}" />
                                </controls:SettingRow>

<!--
                                    След рисуется не в пикселях кадра, а по значениям, поэтому
                                    задан временем: на экране и в ролике он живёт одинаково,
                                    какой бы частоты кадров ни был ролик. Это не спад из
                                    вкладки «Спектр и EQ»: спад замедляет уменьшение высоты,
                                    а след оставляет призрак прежней.
                                -->
                                <controls:SettingRow Label="{Binding Settings.BarTrailDecayMs, StringFormat={}След: {0:0} мс}">
                                    <Slider Minimum="0" Maximum="1500" TickFrequency="50" IsSnapToTickEnabled="True"
                                            Value="{Binding Settings.BarTrailDecayMs, Mode=TwoWay}" />
                                </controls:SettingRow>

<!--
                                    Плотность ниже единицы обязательна: при единице след у
                                    вершины того же цвета, что и столбик, и границы между ними
                                    не видно.
                                -->
                                <controls:SettingRow Label="{Binding Settings.BarTrailDensity, StringFormat={}Плотность: {0:0.00}}">
                                    <Slider Minimum="0" Maximum="1" TickFrequency="0.05"
                                            Value="{Binding Settings.BarTrailDensity, Mode=TwoWay}" />
                                </controls:SettingRow>

                                <controls:SettingRow Label="Зеркалить вниз">
                                    <CheckBox IsChecked="{Binding Settings.BarMirror, Mode=TwoWay}"
                                              Foreground="{StaticResource TextBrush}"
                                              VerticalAlignment="Bottom"
                                              ToolTip="Столбики расходятся от центра вверх и вниз" />
                                </controls:SettingRow>

                                <Button HorizontalAlignment="Right"
                                        Margin="0,10,0,0"
                                        Style="{StaticResource IconButton}"
                                        ToolTip="Сбросить столбики"
                                        Command="{Binding Settings.ResetBarsCommand}"
                                        AutomationProperties.Name="Сбросить столбики">
                                    <Path Style="{StaticResource IconPathSolid}" Data="{StaticResource IconReset}" />
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Спектр и эквалайзер -->
                    <TabItem Header="Спектр и EQ">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,0,0">
                            <StackPanel>
                                <controls:SettingRow Label="{Binding Settings.MinFrequencyHz, StringFormat={}От: {0:0} Гц}">
                                    <Slider Minimum="20" Maximum="1000" Value="{Binding Settings.MinFrequencyHz, Mode=TwoWay}" />
                                </controls:SettingRow>
                                <controls:SettingRow Label="{Binding Settings.MaxFrequencyHz, StringFormat={}До: {0} Гц}">
                                    <Slider Minimum="2000" Maximum="22050" Value="{Binding Settings.MaxFrequencyHz, Mode=TwoWay}" />
                                </controls:SettingRow>
                                <controls:SettingRow Label="{Binding Settings.MinDecibels, StringFormat={}Порог: {0:0} дБ}">
                                    <Slider Minimum="-120" Maximum="0" Value="{Binding Settings.MinDecibels, Mode=TwoWay}" />
                                </controls:SettingRow>
                                <controls:SettingRow Label="{Binding Settings.MaxDecibels, StringFormat={}Потолок: {0:0} дБ}">
                                    <Slider Minimum="-60" Maximum="20" Value="{Binding Settings.MaxDecibels, Mode=TwoWay}" />
                                </controls:SettingRow>
                                <controls:SettingRow Label="{Binding Settings.GainDb, StringFormat={}Усиление: {0:0} дБ}">
                                    <Slider Minimum="-30" Maximum="30" Value="{Binding Settings.GainDb, Mode=TwoWay}" />
                                </controls:SettingRow>
                                <controls:SettingRow Label="{Binding Settings.Gamma, StringFormat={}Кривизна: {0:0.00}}">
                                    <Slider Minimum="0.2" Maximum="3" TickFrequency="0.05" Value="{Binding Settings.Gamma, Mode=TwoWay}" />
                                </controls:SettingRow>
                                <controls:SettingRow Label="{Binding Settings.Attack, StringFormat={}Атака: {0:0.00}}">
                                    <Slider Minimum="0.05" Maximum="1" TickFrequency="0.05" Value="{Binding Settings.Attack, Mode=TwoWay}" />
                                </controls:SettingRow>
                                <controls:SettingRow Label="{Binding Settings.Release, StringFormat={}Спад: {0:0.00}}">
                                    <Slider Minimum="0.02" Maximum="1" TickFrequency="0.02" Value="{Binding Settings.Release, Mode=TwoWay}" />
                                </controls:SettingRow>

                                <TextBlock Text="Эквалайзер" Style="{StaticResource SectionHeader}" />

                                <!--
                                    Полосы гнут форму спектра всегда, а звук меняют только с этой
                                    галочкой: без неё эквалайзер остаётся картинкой. Подсказка
                                    стоит на строке, а не на самом чекбоксе: ToolTipService
                                    показывает подсказку предка, и текст остаётся в одном месте.
                                -->
                                <controls:SettingRow Label="Эквалайзер в звуке"
                                                    ToolTip="Полосы эквалайзера меняют звук в превью и в ролике">
                                    <CheckBox IsChecked="{Binding Settings.ApplyEqualizerToAudio, Mode=TwoWay}"
                                              Foreground="{StaticResource TextBrush}"
                                              VerticalAlignment="Bottom" />
                                </controls:SettingRow>

                                <ItemsControl ItemsSource="{Binding Settings.Equalizer}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="52" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextBrush}"
                                                           Text="{Binding Title}" />
                                                <Slider Grid.Column="1"
                                                        Minimum="-12"
                                                        Maximum="12"
                                                        Value="{Binding GainDb, Mode=TwoWay}" />
                                                <TextBlock Grid.Column="2"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding GainDb, StringFormat={}{0:0.0} дБ}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button HorizontalAlignment="Right"
                                        Margin="0,10,0,0"
                                        Style="{StaticResource IconButton}"
                                        ToolTip="Сбросить спектр и эквалайзер"
                                        Command="{Binding Settings.ResetSpectrumCommand}"
                                        AutomationProperties.Name="Сбросить спектр и эквалайзер">
                                    <Path Style="{StaticResource IconPathSolid}" Data="{StaticResource IconReset}" />
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Экспорт -->
                    <TabItem x:Name="ExportTab" Header="Экспорт">

                        <!--
                            Настройки прокручиваются, а блок выгрузки прибит к низу вкладки и
                            в прокрутку не входит: стоял он последним в списке и уезжал за
                            верхний край панели ровно тогда, когда он и нужен - когда человек
                            ждёт этапа выгрузки, полосы и кнопки отмены.
                        -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollViewer Grid.Row="0"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="4,8,0,8">
                                <StackPanel>
                                    <TextBlock Text="Видео выгружается в mp4 (H.264 + AAC)." Style="{StaticResource SectionHeader}" />

<!--
                                        Пресет вынесен над ползунками: сначала выбирается готовый
                                        набор, потом он подстраивается под себя. Свой пресет -
                                        это весь набор параметров ролика, а не только размер,
                                        поэтому выбор ручной правки сбрасывает.
                                    -->
                                    <controls:SettingRow Label="Пресет выгрузки">
                                        <StackPanel>
                                            <ComboBox ItemsSource="{Binding Settings.ExportPresets}"
                                                      ItemTemplate="{StaticResource ExportPresetTemplate}"
                                                      SelectedItem="{Binding Settings.SelectedExportPreset, Mode=TwoWay}" />
                                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                <Button Style="{StaticResource IconButton}"
                                                        ToolTip="Сохранить пресет"
                                                        AutomationProperties.Name="Сохранить пресет"
                                                        Command="{Binding Settings.StartNamingExportPresetCommand}">
                                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSaveAs}" />
                                                </Button>
                                                <Button Margin="6,0,0,0"
                                                        Style="{StaticResource IconButton}"
                                                        ToolTip="Удалить пресет"
                                                        AutomationProperties.Name="Удалить пресет"
                                                        Command="{Binding Settings.DeleteExportPresetCommand}">
                                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconDelete}" />
                                                </Button>
                                            </StackPanel>

<!--
                                                Поле имени и сообщение о нём живут вместе: вне этого
                                                блока пустая строка сообщения съедала бы место под
                                                списком, а появляется сообщение именно здесь.
                                            -->
                                            <StackPanel Margin="0,6,0,0"
                                                        Visibility="{Binding Settings.IsNamingExportPreset, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBox Text="{Binding Settings.NewExportPresetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                    <Button Style="{StaticResource IconButton}"
                                                            ToolTip="Применить"
                                                            AutomationProperties.Name="Применить"
                                                            Command="{Binding Settings.SaveExportPresetCommand}">
                                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSave}" />
                                                    </Button>
                                                    <Button Margin="6,0,0,0"
                                                            Style="{StaticResource IconButton}"
                                                            ToolTip="Отмена"
                                                            AutomationProperties.Name="Отмена"
                                                            Command="{Binding Settings.CancelNamingExportPresetCommand}">
                                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconCancel}" />
                                                    </Button>
                                                </StackPanel>
                                                <TextBlock Margin="0,6,0,0"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding Settings.PresetsMessage}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </controls:SettingRow>

                                    <controls:SettingRow Label="{Binding Settings.ExportWidth, StringFormat={}Ширина: {0} px}">
                                        <Slider Minimum="320" Maximum="3840" Value="{Binding Settings.ExportWidth, Mode=TwoWay}" />
                                    </controls:SettingRow>
                                    <controls:SettingRow Label="{Binding Settings.ExportHeight, StringFormat={}Высота: {0} px}">
                                        <Slider Minimum="240" Maximum="2160" Value="{Binding Settings.ExportHeight, Mode=TwoWay}" />
                                    </controls:SettingRow>
                                    <controls:SettingRow Label="{Binding Settings.ExportFramesPerSecond, StringFormat={}Кадров: {0} к/с}">
                                        <Slider Minimum="1" Maximum="120" Value="{Binding Settings.ExportFramesPerSecond, Mode=TwoWay}" />
                                    </controls:SettingRow>
                                    <controls:SettingRow Label="Кодирование">
                                        <ComboBox ItemsSource="{Binding Settings.EncoderChoices}"
                                                  ItemTemplate="{StaticResource ChoiceTemplate}"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding Settings.VideoEncoder, Mode=TwoWay}" />
                                    </controls:SettingRow>
                                    <!--
                                        Строка под списком скрывается, когда говорить нечего:
                                        при найденной видеокарте сообщения нет вовсе, а пустой
                                        блок с отступом всё равно держал бы высоту.
                                    -->
                                    <TextBlock Margin="0,0,0,4"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding Settings.EncodersMessage}"
                                               Visibility="{Binding Settings.HasEncodersMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <controls:SettingRow Label="Кодек видео"
                                                        ToolTip="H.265 — файл меньше, кодирование дольше">
                                        <ComboBox ItemsSource="{Binding Settings.VideoCodecChoices}"
                                                  ItemTemplate="{StaticResource ChoiceTemplate}"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding Settings.VideoCodec, Mode=TwoWay}" />
                                    </controls:SettingRow>
                                    <controls:SettingRow Label="{Binding Settings.Crf, StringFormat={}Качество CRF {0}}">
                                        <Slider Minimum="0" Maximum="40" Value="{Binding Settings.Crf, Mode=TwoWay}" />
                                    </controls:SettingRow>
                                    <controls:SettingRow Label="Пресет кодека">
                                        <ComboBox ItemsSource="{Binding Settings.CodecPresets}"
                                                  SelectedItem="{Binding Settings.CodecPreset, Mode=TwoWay}" />
                                    </controls:SettingRow>
                                    <controls:SettingRow Label="{Binding Settings.AudioBitrateKbps, StringFormat={}Звук: {0} кбит/с}">
                                        <Slider Minimum="64" Maximum="320" Value="{Binding Settings.AudioBitrateKbps, Mode=TwoWay}" />
                                    </controls:SettingRow>
                                    <controls:SettingRow Label="Кодировщик звука">
                                        <ComboBox ItemsSource="{Binding Settings.AacCoderChoices}"
                                                  SelectedItem="{Binding Settings.AacCoder, Mode=TwoWay}" />
                                    </controls:SettingRow>
                                    <TextBlock Margin="0,0,0,4"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="На одном из кодировщиков выгрузка может зависнуть. Если ffmpeg перестал читать кадры, попробуйте другой." />

<!--
                                        Подсказка задана на строке, а не на чекбоксе: ToolTipService
                                        показывает подсказку предка, если у наведённого элемента
                                        своей нет. Подпись в шаблоне SettingRow и сам чекбокс своей
                                        не имеют, поэтому одного значения хватает на оба места, а
                                        текст остаётся в одном.
                                    -->
                                    <controls:SettingRow Label="Тихая выгрузка"
                                                        ToolTip="Не показывать окно об удачной выгрузке">
                                        <CheckBox IsChecked="{Binding Settings.QuietExport, Mode=TwoWay}"
                                                  Foreground="{StaticResource TextBrush}"
                                                  VerticalAlignment="Bottom" />
                                    </controls:SettingRow>

                                    <TextBlock Text="ffmpeg" Style="{StaticResource SectionHeader}" />
                                    <TextBlock Margin="0,0,0,4"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="Путь к ffmpeg.exe. Пусто - искать в PATH." />
                                    <TextBox Text="{Binding Settings.FfmpegPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <Button HorizontalAlignment="Right"
                                            Margin="0,10,0,0"
                                            Style="{StaticResource IconButton}"
                                            ToolTip="Сбросить параметры выгрузки"
                                            Command="{Binding Settings.ResetExportCommand}"
                                            AutomationProperties.Name="Сбросить параметры выгрузки">
                                        <Path Style="{StaticResource IconPathSolid}" Data="{StaticResource IconReset}" />
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>

                            <!--
                                Разделитель сверху обязателен: без него прибитое и
                                прокручиваемое выглядят одним списком, и границу, за
                                которой кончается прокрутка, видно только по тому, что
                                полоса упёрлась в край.
                            -->
                            <Border x:Name="ExportFooter"
                                    Grid.Row="1"
                                    Padding="4,10,0,10"
                                    BorderBrush="{StaticResource PanelBorder}"
                                    BorderThickness="0,1,0,0">
                                <StackPanel>

<!--
                                    Выгрузка считает кадры в фоне и занимает все ядра, поэтому
                                    идёт отдельным потоком и показывает прогресс. Отмена
                                    доступна всё время: длинный ролик иначе пришлось бы ждать.
                                -->
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="Выгрузка" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}"
                                                Width="36"
                                                Height="32"
                                                ToolTip="Выгрузить mp4"
                                                AutomationProperties.Name="Выгрузить mp4"
                                                Command="{Binding ExportVideoCommand}">
                                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconExport}" />
                                        </Button>
                                        <Button Margin="8,0,0,0"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="Отменить выгрузку"
                                                AutomationProperties.Name="Отменить выгрузку"
                                                Command="{Binding CancelExportCommand}">
                                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconCancel}" />
                                        </Button>
                                    </StackPanel>

<!--
                                        Место под полосу зарезервировано постоянно, а полоса
                                        появляется и пропадает: иначе в момент старта выгрузки
                                        прибитый блок вырос бы на её высоту и кнопки уехали
                                        бы вверх прямо под рукой. Заодно полоса не остаётся
                                        висеть заполненной после успешной выгрузки.
                                    -->
                                    <Grid Height="14" Margin="0,10,0,0">
                                        <ProgressBar Height="4"
                                                     VerticalAlignment="Center"
                                                     Minimum="0"
                                                     Maximum="1"
                                                     Value="{Binding ExportProgress}"
                                                     Visibility="{Binding IsExporting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                    <TextBlock Margin="0,6,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding ExportProgressText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                </TabControl>
            </Border>
        </Grid>

        <!-- Статус -->
        <Grid Grid.Row="3" Margin="12,0,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <!--
                    Ошибки красные, остальные сообщения обычные. Признак берётся у модели окна:
                    DataContext у этой надписи и есть MainViewModel, поэтому ссылка без
                    RelativeSource разрешается сама собой.

                    В строке только заголовок ошибки, подробности - в подсказке. Сама подсказка
                    не задана разметкой и приходит из StatusHint.Attach: содержимое ToolTip живёт
                    в попапе, DataContext в него не наследуется, и привязка внутри подсказки
                    выглядит работающей, пока не окажется пустой.

                    Пустая подсказка гасится признаком, иначе у обычных сообщений по наведению
                    появлялся бы пустой прямоугольник.
                -->
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding Status}">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource StatusErrorBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusDetail}" Value="">
                                <Setter Property="ToolTipService.IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ProgressBar Grid.Column="1"
                         Height="4"
                         IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

    </Grid>
</Window>